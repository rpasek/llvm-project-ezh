command source ../ezh_launcher.lldb

# Start EZH execution
expr *$EZHB_BOOT_ADDR = (unsigned int)&_start
expr *$EZHB_CTRL_ADDR = $EZHB_CTRL_START_KEY

# Wait for execution (ctimer_test takes 5 seconds)
shell sleep 7.5

# Print final results
p/x exc_signal
process detach
quit
