# Load symbols
target create "out/ezh_test.elf"

# Disable LLDB target memory cache
#settings set target.process.disable-memory-cache true

# Connect to remote OpenOCD JTAG server
process connect -p ezh-remote connect://localhost:3333

# Define register addresses and constants
expr unsigned int * $EZHB_BOOT_ADDR = (unsigned int *)0x40027020
expr unsigned int * $EZHB_CTRL_ADDR = (unsigned int *)0x40027024
expr unsigned int * $EZHB_PENDTRAP_ADDR = (unsigned int *)0x40027048
expr unsigned int $EZHB_CTRL_WRITE_KEY = 0xC0DE0000
expr unsigned int $EZHB_CTRL_START_KEY = 0xC0DE0011

expr unsigned int * $RSTCTL0_PRSTCTL0_SET_ADDR = (unsigned int *)0x40000040
expr unsigned int * $RSTCTL0_PRSTCTL0_CLR_ADDR = (unsigned int *)0x40000070
expr unsigned int $RSTCTL0_PRSTCTL0_SMARTDMA_MASK = 0x40000000

# Toggle SMARTDMA reset via atomic SET/CLR registers
expr *$RSTCTL0_PRSTCTL0_SET_ADDR = $RSTCTL0_PRSTCTL0_SMARTDMA_MASK
expr *$RSTCTL0_PRSTCTL0_CLR_ADDR = $RSTCTL0_PRSTCTL0_SMARTDMA_MASK

# Initialize exc_signal to 0xFFFFFFFF
expr exc_signal = 0xFFFFFFFF

# Load ELF sections
target modules load --load --file ezh_test.elf --slide 0

# Clear bit slice
expr *$EZHB_PENDTRAP_ADDR = 0x00000080
