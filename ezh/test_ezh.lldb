# Disable ANSI colors
settings set use-color false

# Load symbols
target create "out/ezh_test.elf"

# Connect to remote OpenOCD JTAG server
process connect -p ezh-remote connect://localhost:3333

# Halt EZH core to unlock RAM access
memory write -s 4 0x40027024 0xC0DE0000

# Toggle SMARTDMA reset
expr *(volatile int *)0x40000010 |= (1 << 30)
expr *(volatile int *)0x40000010 &= ~(1 << 30)

# Clear exc_signal
expr exc_signal = 0

# Load ELF sections
target modules load --load --file ezh_test.elf --slide 0

# Clear bit slice
memory write -s 4 0x40027048 0x00000080

# Start EZH execution
expr *(volatile int *)0x40027020 = (int)&_start
memory write -s 4 0x40027024 0xC0DE0011

# Wait for execution
shell sleep 1.0

# Print final core results in exact format expected by run.sh!
x/s &printf_buffer
p/x exc_signal
process detach
quit
